# Neon (or any Postgres) connection string for Nuke itself
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password you type on the login screen
NUKE_PASSWORD=choose-a-strong-password

# Long random string used to sign login cookies (16+ chars)
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Encrypts every project environment variable stored in the database (32+ chars).
# Generate: openssl rand -hex 32
# SET ONCE AND NEVER CHANGE IT, or saved values can no longer be decrypted. Keep a backup.
NUKE_SECRETS_ENCRYPTION_KEY=

# Optional: lets "Import from GitHub" read private repos
GITHUB_TOKEN=
