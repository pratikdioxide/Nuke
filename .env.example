# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password you type on the login screen
NUKE_PASSWORD=choose-a-strong-password

# Long random string used to sign login cookies (>= 16 chars)
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Encrypts per-project private API secrets at rest. Keep this value stable;
# changing it makes previously saved secrets unreadable.
# Generate: openssl rand -hex 32
NUKE_SECRETS_ENCRYPTION_KEY=

# Optional: lets "Import from GitHub" read private repos
GITHUB_TOKEN=
